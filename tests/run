#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
quattro_root=${OMARCHY_QUATTRO_PATH:-${OMARCHY_PATH:-/usr/share/omarchy}}
test_root=$(mktemp -d)
trap 'rm -rf -- "$test_root"' EXIT
# Scripts started by the tests resolve Quotatank's private folders (and move a 1.x one) from these;
# never let them reach the developer's own keys and state.
export XDG_STATE_HOME="$test_root/state"

python3 -m py_compile "$repo_root/scripts/quotatank_common.py"
python3 -m py_compile "$repo_root/scripts/usage-fetch.py"
python3 -m py_compile "$repo_root/scripts/cost-fetch.py"
python3 -m py_compile "$repo_root/scripts/t3_costs.py"
python3 -m py_compile "$repo_root/scripts/omp_stats.py"
python3 -m py_compile "$repo_root/scripts/keeper_client.py"
python3 -m py_compile "$repo_root/scripts/proxy-activity.py"
python3 -m py_compile "$repo_root/scripts/omp-live.py"
python3 -m py_compile "$repo_root/scripts/management-key.py"
python3 -m py_compile "$repo_root/scripts/reset-credit.py"
python3 -m py_compile "$repo_root/scripts/backup.py"
XDG_CONFIG_HOME="$test_root/config" python3 -m unittest discover -s "$repo_root/tests" -p 'test_*.py' -v
node "$repo_root/tests/test_usage_logic.js"

if command -v omarchy >/dev/null 2>&1 && omarchy plugin validate --help >/dev/null 2>&1; then
  omarchy plugin validate "$repo_root"
else
  echo "omarchy plugin validate unavailable; manifest contract tests still ran"
fi

# Qt 6 qmllint understands the flags below; the Qt 5 one on PATH rejects them.
if [[ -x /usr/lib/qt6/bin/qmllint ]]; then
  qml_lint=/usr/lib/qt6/bin/qmllint
else
  qml_lint=$(command -v qmllint || true)
fi

if [[ -n $qml_lint && -d "$quattro_root/shell/Ui" ]]; then
  lint_root="$test_root/lint"
  mkdir -p "$lint_root/qs"
  ln -s "$quattro_root/shell/Ui" "$lint_root/qs/Ui"
  ln -s "$quattro_root/shell/Commons" "$lint_root/qs/Commons"
  lint_log="$lint_root/qmllint.log"
  lint_flags=(-W 0 --missing-property disable --signal-handler-parameters disable)
  # The widget's JavaScript declares with `var` throughout, on purpose; Qt 6.12 added a warning for it.
  lint_help=$("$qml_lint" --help 2>/dev/null || true)
  if [[ $lint_help == *--block-scope-var-declaration* ]]; then
    lint_flags+=(--block-scope-var-declaration disable)
  fi
  if ! "$qml_lint" "${lint_flags[@]}" -I "$lint_root" "$repo_root"/*.qml >"$lint_log" 2>&1; then
    sed -n '1,240p' "$lint_log"
    exit 1
  fi
  echo "qmllint: passed (dynamic Omarchy/Quickshell type warnings disabled)"
else
  echo "qmllint or Quattro source unavailable; skipping QML lint"
fi

if command -v quickshell >/dev/null 2>&1 && [[ -d "$quattro_root/shell/Ui" ]]; then
  quota_root="$test_root/quota"
  mkdir -p "$quota_root"
  cp "$repo_root/tests/qml/quota-shell.qml" "$quota_root/shell.qml"
  repo_url=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$repo_root")
  QT_QPA_PLATFORM=offscreen \
  QUOTATANK_REPO_URL="$repo_url" \
  QUOTATANK_FAKE_BACKEND="$repo_root/tests/fake_quota_refresh.py" \
  QUOTATANK_QUOTA_REQUESTS="$quota_root/requests.jsonl" \
  PATH="$repo_root/tests/fake-bin:$PATH" \
    timeout 8 quickshell -p "$quota_root" --no-color >"$quota_root/runtime.log" 2>&1 || {
      cat "$quota_root/runtime.log"
      exit 1
    }
  if ! rg -q 'Quota QML contract: passed' "$quota_root/runtime.log" \
      || rg -n 'Error:|ReferenceError|TypeError|Binding loop|Unable to assign|failed to load|QUOTA TEST FAILED' "$quota_root/runtime.log"; then
    cat "$quota_root/runtime.log"
    exit 1
  fi
  python3 - "$quota_root/requests.jsonl" <<'PY'
import json
import pathlib
import sys
requests = [json.loads(line) for line in pathlib.Path(sys.argv[1]).read_text().splitlines()]
assert len(requests) == 4, "refreshes must coalesce without losing the latest request"
assert requests[0]["cliproxy_url"] == "https://old.example"
assert all(row["cliproxy_url"] == "https://new.example" for row in requests[1:])
PY
  echo "Quota QML contract: passed (startup refreshes and connection changes)"

  activity_root="$test_root/activity"
  mkdir -p "$activity_root"
  cp "$repo_root/tests/qml/activity-shell.qml" "$activity_root/shell.qml"
  repo_url=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$repo_root")
  QT_QPA_PLATFORM=offscreen \
  QUOTATANK_REPO_URL="$repo_url" \
  QUOTATANK_FAKE_ACTIVITY="$repo_root/tests/fake_activity.py" \
  QUOTATANK_ACTIVITY_MARKER="$activity_root/second-request" \
    timeout 10 quickshell -p "$activity_root" --no-color >"$activity_root/runtime.log" 2>&1 || {
      cat "$activity_root/runtime.log"
      exit 1
    }
  if ! rg -q 'Activity QML contract: passed' "$activity_root/runtime.log" \
      || rg -n 'Error:|ReferenceError|TypeError|Binding loop|Unable to assign|failed to load|ACTIVITY TEST FAILED' "$activity_root/runtime.log"; then
    cat "$activity_root/runtime.log"
    exit 1
  fi
  echo "Activity QML contract: passed (synthetic account switches, outages, and connection changes)"

  cost_root="$test_root/cost"
  mkdir -p "$cost_root/config" "$cost_root/cache"
  cp "$repo_root/tests/qml/cost-shell.qml" "$cost_root/shell.qml"
  ln -s "$quattro_root/shell/Ui" "$cost_root/Ui"
  ln -s "$quattro_root/shell/Commons" "$cost_root/Commons"
  repo_url=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$repo_root")
  QT_QPA_PLATFORM=offscreen \
  XDG_CONFIG_HOME="$cost_root/config" XDG_CACHE_HOME="$cost_root/cache" \
  QUOTATANK_REPO_URL="$repo_url" \
  QUOTATANK_FAKE_COST_BACKEND="$repo_root/tests/fake_cost_backend.py" \
  QUOTATANK_COST_FIXTURE="$repo_root/tests/fixtures/normalized-costs.json" \
  QUOTATANK_COST_DIMENSIONS_FIXTURE="$repo_root/tests/fixtures/normalized-costs-dimensions.json" \
  PATH="$repo_root/tests/fake-bin:$PATH" \
  QML_IMPORT_PATH="$quattro_root/shell${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
    timeout 30 quickshell -p "$cost_root" --no-color >"$cost_root/runtime.log" 2>&1 || {
      cat "$cost_root/runtime.log"
      exit 1
    }
  if ! rg -q 'Cost QML contract: passed' "$cost_root/runtime.log" \
      || rg -n 'Error:|ReferenceError|TypeError|Binding loop|Unable to assign|failed to load|failed to instantiate|COST TEST FAILED' "$cost_root/runtime.log"; then
    cat "$cost_root/runtime.log"
    exit 1
  fi
  echo "Cost QML contract: passed (synthetic prices and processes, no popup windows)"

  settings_root="$test_root/settings"
  mkdir -p "$settings_root/config" "$settings_root/cache"
  cp "$repo_root/tests/qml/settings-shell.qml" "$settings_root/shell.qml"
  ln -s "$quattro_root/shell/Ui" "$settings_root/Ui"
  ln -s "$quattro_root/shell/Commons" "$settings_root/Commons"
  QT_QPA_PLATFORM=offscreen \
  XDG_CONFIG_HOME="$settings_root/config" XDG_CACHE_HOME="$settings_root/cache" \
  QUOTATANK_REPO_URL="$repo_url" \
  QUOTATANK_FAKE_BACKEND="$repo_root/tests/fake_omp_usage.py" \
  QUOTATANK_FAKE_COST_BACKEND="$repo_root/tests/fake_omp_costs.py" \
  QUOTATANK_FAKE_OMP_LIVE="$repo_root/tests/fake_omp_live.py" \
  QUOTATANK_OMP_LIVE_MARKER="$settings_root/live.jsonl" \
  QUOTATANK_COPY_LOG="$settings_root/copied.jsonl" \
  PATH="$repo_root/tests/fake-bin:$PATH" \
  QML_IMPORT_PATH="$quattro_root/shell${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
    timeout 30 quickshell -p "$settings_root" --no-color >"$settings_root/runtime.log" 2>&1 || {
      cat "$settings_root/runtime.log"
      exit 1
    }
  if ! rg -q 'Settings QML contract: passed' "$settings_root/runtime.log" \
      || rg -n 'Error:|ReferenceError|TypeError|Binding loop|Unable to assign|failed to load|failed to instantiate|SETTINGS TEST FAILED' "$settings_root/runtime.log"; then
    cat "$settings_root/runtime.log"
    exit 1
  fi
  python3 - "$settings_root/live.jsonl" "$settings_root/copied.jsonl" <<'PY'
import json
import pathlib
import sys
rows = [json.loads(line) for line in pathlib.Path(sys.argv[1]).read_text().splitlines()]
starts = [row for row in rows if row["event"] == "start"]
stops = [row for row in rows if row["event"] == "stop"]
assert {row["pid"] for row in starts} == {row["pid"] for row in stops}, "every omp-live helper stops with its last panel"
shared = [row for row in starts if row["host"] == "devbox"]
assert len(shared) == 1, "panels following the same omp setup share one helper"
assert shared[0]["argv"] == ["--local", "--accounts", "--stats-url", "http://devbox:3847"], shared[0]["argv"]
assert any(row["host"] == "broken" for row in starts), "a broken feed was started"
copied = [json.loads(line) for line in pathlib.Path(sys.argv[2]).read_text().splitlines()]
assert copied == [["--type", "text/plain;charset=utf-8", "--", "omp auth-gateway token"]], copied
PY
  echo "Settings QML contract: passed (omp source states, Test results, copied commands, backend flags, shared live feed)"

  reset_root="$test_root/reset"
  mkdir -p "$reset_root/config" "$reset_root/cache"
  cp "$repo_root/tests/qml/reset-shell.qml" "$reset_root/shell.qml"
  ln -s "$quattro_root/shell/Ui" "$reset_root/Ui"
  ln -s "$quattro_root/shell/Commons" "$reset_root/Commons"
  repo_url=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$repo_root")
  reset_platform=offscreen
  if [[ -n ${WAYLAND_DISPLAY:-} ]]; then reset_platform=wayland; fi
  QT_QPA_PLATFORM="$reset_platform" \
  XDG_CONFIG_HOME="$reset_root/config" XDG_CACHE_HOME="$reset_root/cache" \
  QUOTATANK_REPO_URL="$repo_url" QUOTATANK_FAKE_RESET="$repo_root/tests/fake_reset.py" \
  QUOTATANK_RESET_LOG="$reset_root/requests.jsonl" \
  QUOTATANK_FAKE_BACKEND="$repo_root/tests/fake_backend.py" \
  QUOTATANK_FAKE_COST_BACKEND="$repo_root/tests/fake_cost_backend.py" \
  QUOTATANK_NORMALIZED_FIXTURE="$repo_root/tests/fixtures/normalized-all.json" \
  PATH="$repo_root/tests/fake-bin:$PATH" \
  QML_IMPORT_PATH="$quattro_root/shell${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
    timeout 15 quickshell -p "$reset_root" --no-color >"$reset_root/runtime.log" 2>&1 || {
      cat "$reset_root/runtime.log"
      exit 1
    }
  if ! rg -q 'Reset QML contract: passed' "$reset_root/runtime.log" \
      || rg -n 'Error:|ReferenceError|TypeError|Binding loop|Unable to assign|failed to load|failed to instantiate|RESET TEST FAILED' "$reset_root/runtime.log"; then
    cat "$reset_root/runtime.log"
    exit 1
  fi
  python3 - "$reset_root/requests.jsonl" <<'PY'
import json
import pathlib
import sys
calls = [json.loads(line) for line in pathlib.Path(sys.argv[1]).read_text().splitlines()]
requests = [call for call in calls if call["action"] == "consume" and call["provider"] == "codex"]
assert len(requests) == 2, "double clicks, cancellation and stale confirmations must not consume"
assert requests[0] == requests[1], "retry must reuse the same account, credit and request ID"
assert requests[0]["credit_id"] == "second", "the selected credit must be consumed"
assert all(call["source"] == "cliproxy" and call["cliproxy_url"] for call in calls if call["provider"] == "codex"), calls
claude = [call for call in calls if call["provider"] == "claude"]
assert [call["action"] for call in claude] == ["prepare", "consume"], claude
assert all(call["source"] == "direct" and call["account_id"] == "main" and call["cliproxy_url"] is None
           and call["cliproxy_key_file"] is None for call in claude), claude
assert (claude[1]["target"], claude[1]["credit_id"], claude[1]["request_id"]) == ("claude-target", "launch-reset", "claude-request")
PY
  echo "Reset QML contract: passed (synthetic backend, no popup windows)"

  limits_root="$test_root/limits"
  mkdir -p "$limits_root/config" "$limits_root/cache" "$limits_root/markers"
  cp "$repo_root/tests/qml/limits-shell.qml" "$limits_root/shell.qml"
  ln -s "$repo_root/UsageLogic.js" "$limits_root/UsageLogic.js"
  ln -s "$quattro_root/shell/Ui" "$limits_root/Ui"
  ln -s "$quattro_root/shell/Commons" "$limits_root/Commons"
  limits_platform=offscreen
  if [[ -n ${WAYLAND_DISPLAY:-} ]]; then limits_platform=wayland; fi
  QT_QPA_PLATFORM="$limits_platform" \
  XDG_CONFIG_HOME="$limits_root/config" XDG_CACHE_HOME="$limits_root/cache" \
  QUOTATANK_REPO_URL="$repo_url" \
  QUOTATANK_FAKE_BACKEND="$repo_root/tests/fake_accounts_backend.py" \
  QUOTATANK_FAKE_COST_BACKEND="$repo_root/tests/fake_cost_backend.py" \
  QUOTATANK_COST_FIXTURE="$repo_root/tests/fixtures/normalized-costs.json" \
  QUOTATANK_ACCOUNTS_MARKERS="$limits_root/markers" \
  PATH="$repo_root/tests/fake-bin:$PATH" \
  QML_IMPORT_PATH="$quattro_root/shell${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
    timeout 30 quickshell -p "$limits_root" --no-color >"$limits_root/runtime.log" 2>&1 || {
      cat "$limits_root/runtime.log"
      exit 1
    }
  if ! rg -q 'Limits QML contract: passed' "$limits_root/runtime.log" \
      || rg -n 'Error:|ReferenceError|TypeError|Binding loop|Unable to assign|failed to load|failed to instantiate|LIMITS TEST FAILED' "$limits_root/runtime.log"; then
    cat "$limits_root/runtime.log"
    exit 1
  fi
  echo "Limits QML contract: passed (account rows, model moves, Use, forecasts, runway gap, notices)"

  # Menu bar chip: components offscreen (motion, rolling digits, account dots, hints, pie, hover card);
  # Panel.qml's chips need a layer-shell, so that half runs only inside a Wayland session.
  bar_root="$test_root/bar"
  mkdir -p "$bar_root/config" "$bar_root/cache"
  cp "$repo_root/tests/qml/bar-shell.qml" "$bar_root/shell.qml"
  ln -s "$quattro_root/shell/Ui" "$bar_root/Ui"
  ln -s "$quattro_root/shell/Commons" "$bar_root/Commons"
  bar_phases=(components)
  if [[ -n ${WAYLAND_DISPLAY:-} ]]; then bar_phases+=(panel); fi
  for bar_phase in "${bar_phases[@]}"; do
    bar_platform=offscreen
    if [[ $bar_phase == panel ]]; then bar_platform=wayland; fi
    QT_QPA_PLATFORM="$bar_platform" QUOTATANK_BAR_PHASE="$bar_phase" \
    XDG_CONFIG_HOME="$bar_root/config" XDG_CACHE_HOME="$bar_root/cache" \
    QUOTATANK_REPO_URL="$repo_url" \
    QUOTATANK_FAKE_BACKEND="$repo_root/tests/fake_backend.py" \
    QUOTATANK_FAKE_COST_BACKEND="$repo_root/tests/fake_cost_backend.py" \
    QUOTATANK_NORMALIZED_FIXTURE="$repo_root/tests/fixtures/normalized-accounts.json" \
    PATH="$repo_root/tests/fake-bin:$PATH" \
    QML_IMPORT_PATH="$quattro_root/shell${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
      timeout 20 quickshell -p "$bar_root" --no-color >"$bar_root/$bar_phase.log" 2>&1 || {
        cat "$bar_root/$bar_phase.log"
        exit 1
      }
    if ! rg -q "Bar QML contract: passed \\($bar_phase" "$bar_root/$bar_phase.log" \
        || rg -n 'Error:|ReferenceError|TypeError|Binding loop|Unable to assign|failed to load|failed to instantiate|BAR TEST FAILED' "$bar_root/$bar_phase.log"; then
      cat "$bar_root/$bar_phase.log"
      exit 1
    fi
  done
  if [[ ${#bar_phases[@]} -eq 2 ]]; then
    echo "Bar QML contract: passed (motion, rolling digits, account dots, hints, pie, hover card, chips per account)"
  else
    echo "Bar QML contract: passed (motion, rolling digits, account dots, hints, pie, hover card; Panel chips need Wayland)"
  fi
fi

if [[ ${QUOTATANK_LIVE_TESTS:-0} != 1 ]]; then
  echo "Live UI tests skipped; set QUOTATANK_LIVE_TESTS=1 to show test popups on the current desktop"
elif command -v quickshell >/dev/null 2>&1 \
    && command -v jq >/dev/null 2>&1 \
    && command -v rg >/dev/null 2>&1 \
    && command -v timeout >/dev/null 2>&1 \
    && [[ -n ${WAYLAND_DISPLAY:-} ]] \
    && [[ -d "$quattro_root/shell/Ui" ]]; then
  runtime_root="$test_root/runtime"
  config_dir="$runtime_root/quotatank-test"
  mkdir -p "$config_dir" "$runtime_root/home"
  cp "$repo_root/tests/qml/shell.qml" "$config_dir/shell.qml"
  ln -s "$quattro_root/shell/Ui" "$config_dir/Ui"
  ln -s "$quattro_root/shell/Commons" "$config_dir/Commons"
  result="$runtime_root/result.json"
  log="$runtime_root/quickshell.log"
  panel_url=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$repo_root/Panel.qml")
  meter_url=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$repo_root/BlockMeter.qml")
  backend_url=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$repo_root/UsageBackend.qml")
  cost_backend_url=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$repo_root/CostBackend.qml")
  cost_view_url=$(python3 -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).resolve().as_uri())' "$repo_root/UsageCosts.qml")

  QUOTATANK_TEST_RESULT="$result" \
  QUOTATANK_PANEL_URL="$panel_url" \
  QUOTATANK_METER_URL="$meter_url" \
  QUOTATANK_BACKEND_URL="$backend_url" \
  QUOTATANK_COST_BACKEND_URL="$cost_backend_url" \
  QUOTATANK_COST_VIEW_URL="$cost_view_url" \
  QUOTATANK_FAKE_BACKEND="$repo_root/tests/fake_backend.py" \
  QUOTATANK_FAKE_COST_BACKEND="$repo_root/tests/fake_cost_backend.py" \
  QUOTATANK_NORMALIZED_FIXTURE="$repo_root/tests/fixtures/normalized-all.json" \
  QUOTATANK_COST_FIXTURE="$repo_root/tests/fixtures/normalized-costs.json" \
  HOME="$runtime_root/home" \
  XDG_CONFIG_HOME="$runtime_root/home/.config" \
  XDG_CACHE_HOME="$runtime_root/home/.cache" \
  XDG_STATE_HOME="$runtime_root/home/.local/state" \
  QML2_IMPORT_PATH="$quattro_root/shell${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}" \
  QML_IMPORT_PATH="$quattro_root/shell${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}" \
  PATH="$repo_root/tests/fake-bin:$PATH" \
    timeout 20 quickshell -p "$config_dir" --no-color >"$log" 2>&1 || {
      sed -n '1,240p' "$log"
      echo "Quickshell runtime contract failed" >&2
      exit 1
    }
  if [[ ! -s $result ]] || ! jq -e '.ok == true' "$result" >/dev/null; then
    [[ -s $result ]] && jq . "$result"
    sed -n '1,240p' "$log"
    echo "Quickshell runtime assertions failed" >&2
    exit 1
  fi
  if rg -n 'Error:|ReferenceError|TypeError|Binding loop|Unable to assign|failed to load|failed to instantiate' "$log"; then
    echo "Quickshell runtime log contains QML errors" >&2
    exit 1
  fi
  python3 - "$runtime_root/home/.config/omarchy/quotatank/management-keys" <<'PY'
import pathlib
import sys
keys = list(pathlib.Path(sys.argv[1]).glob("*.key"))
assert len(keys) == 2, "failed GUI save must roll back both staged credentials"
assert all(key.stat().st_mode & 0o777 == 0o600 for key in keys)
assert {key.read_text() for key in keys} == {"qml-synthetic-management-key\n", "qml-synthetic-keeper-password\n"}
PY
  echo "Quickshell runtime contract: passed"
else
  echo "Live Wayland/Quickshell test unavailable; skipping runtime contract"
fi
