#!/usr/bin/env bash
# Synthetic clipboard for the settings paste checks: the first paste offers a short text, later
# ones more than the 64 KiB a settings field accepts.
set -euo pipefail
state="${XDG_CACHE_HOME:?}/fake-wl-paste-calls"
calls=$(( $(cat "$state" 2>/dev/null || echo 0) + 1 ))
echo "$calls" > "$state"
if (( calls == 1 )); then
  printf 'seek'
else
  head -c 70000 /dev/zero | tr '\0' x
fi
